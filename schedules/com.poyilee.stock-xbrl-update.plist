    <key>StandardOutPath</key>
    <string>/Users/poyilee/Documents/GitHubLL/my_stock_project/logs/launchd_xbrl_update.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/poyilee/Documents/GitHubLL/my_stock_project/logs/launchd_xbrl_update.err.log</string>
</dict>
</plist>
