[Unit]
Description=Taiwan stock daily retry (re-run daily_update.sh if previous run failed)
OnFailure=stock-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/GitHubLL/my_stock_project
ExecStart=/bin/bash %h/GitHubLL/my_stock_project/schedules/daily_retry.sh
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
StandardOutput=journal
StandardError=journal
